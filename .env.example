# Copy to .env and fill locally. Never commit real credentials.
SARVAM_API_KEY=
SARVAM_WS_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_MODEL=saaras:v3-realtime
SARVAM_LANGUAGE_CODE=auto
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=awaaz_tiderag_v1
RAG_LANGUAGE=hi
RAG_TARGET_UNIQUE_PASSAGES=50000
RAG_DEVELOPMENT_PASSAGES=10000
RAG_DEADLINE_MS=200
RAG_FALLBACK_AT_MS=170
RAG_DENSE_MODEL=intfloat/multilingual-e5-small
RAG_DENSE_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_GENERATION_MODE=extractive
# Optional post-primary grounded synthesis. Disabled preserves extractive-only behavior.
# When enabled and requested, the final question/transcript and selected evidence are sent to Groq.
# GROQ_API_KEY is a backend secret: never expose it through a VITE_* variable or commit it.
RAG_ENABLE_GROQ_SYNTHESIS=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_S=8
GROQ_MAX_COMPLETION_TOKENS=384
GROQ_MAX_CONCURRENCY=4
# Short-lived, bounded server-side context used by opaque synthesis offer tokens.
RAG_SYNTHESIS_CONTEXT_TTL_S=60
RAG_SYNTHESIS_CONTEXT_MAX_ENTRIES=256
RAG_ENABLE_ATOMIC_CHUNKS=true
RAG_ENABLE_SENTENCE_WINDOW_CHUNKS=true
RAG_ENABLE_SEMANTIC_CHUNKS=true
RAG_ENABLE_PARENT_CHILD_CHUNKS=true
RAG_ENABLE_BILINGUAL_PAIRED_CHUNKS=true
RAG_ENABLE_SPARSE=true
RAG_ENABLE_LATE_CHUNKING=true
RAG_ENABLE_SPECULATIVE_RETRIEVAL=true
RAG_STORE_RAW_AUDIO=false
RAG_VOICE_IDLE_TIMEOUT_S=30
# Absolute wall-clock cap, including slow/drip-fed audio.
RAG_VOICE_MAX_SESSION_S=90
# Required when ENVIRONMENT=production. Protects text and voice.
RAG_API_TOKEN=
# Optional voice-specific override. Send either configured token as Authorization: Bearer <token>.
RAG_VOICE_API_TOKEN=
# Comma-separated exact browser Origin values. Empty rejects browser-origin WebSockets.
RAG_VOICE_ALLOWED_ORIGINS=
RAG_LOG_LEVEL=INFO
RAG_RANDOM_SEED=2026
RAG_DATA_DIR=data
RAG_THRESHOLDS_PATH=data/calibration/frozen-thresholds.json
RAG_REQUIRE_FROZEN_THRESHOLDS=false
